# Othos settings. Copy this file to .env (setup.ps1 does it) and fill in the keys.
# .env stays on your computer and is never committed. Your name, town and local news
# feeds go in personal.json instead (see personal.example.json). README.md explains
# every line, where to get each key and which ones are optional.

# ---- LiveKit (the call itself; runs on this computer) ----
# Leave LIVEKIT_TOKEN_SERVER_ID blank: Othos uses its own local LiveKit server.
LIVEKIT_TOKEN_SERVER_ID=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Agent dispatch: leave blank for automatic dispatch
AGENT_NAME=
GREET_ON_START=true

# ---- Speech ----
# cloud = Deepgram hears you, Rime speaks (needs both keys; works on a CPU-only laptop)
# local = speech-to-text and voice servers on this computer (needs a graphics card;
#         see README "Fully offline"). Nothing you say leaves the computer.
OTHOS_SPEECH=cloud
# cloud speech
DEEPGRAM_API_KEY=
DEEPGRAM_MIP_OPT_OUT=true
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=holloway
# local speech (OpenAI-compatible servers: Speaches / faster-whisper, Kokoro-FastAPI)
LOCAL_STT_URL=http://127.0.0.1:8000/v1
LOCAL_STT_MODEL=Systran/faster-whisper-small.en
LOCAL_TTS_URL=http://127.0.0.1:8880/v1
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart

# ---- Conversation model (Ollama, on this computer) ----
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ---- Web search (last resort, after the free sources) ----
TAVILY_API_KEY=
# spoken heads-up at this many credits used in the month; stop at the limit (0 = the plan's own)
OTHOS_TAVILY_WARN=1400
OTHOS_TAVILY_LIMIT=0
# Brave Search (optional): tried after the free sources for lists and "near me" searches; Tavily keeps the
# questions it can answer in a sentence. Only the search words are sent. No key = skipped.
BRAVE_API_KEY=
# spoken heads-up at this many Brave searches in the month, and a stop (so free credits aren't passed)
BRAVE_WARN_AT=950
BRAVE_MONTHLY_LIMIT=1000
# OTHOS_BRAVE=all sends every web search to Brave first (slower answers: Brave returns results, not a written answer)

# ---- News outlets for Tavily news searches (comma-separated) ----
# National/political news; world news uses NEWS_SITES (same format, optional)
US_NEWS_SITES=apnews.com,reuters.com,bbc.com,theguardian.com,npr.org,pbs.org,nbcnews.com,abcnews.go.com,cbsnews.com,usatoday.com,axios.com,politico.com,thehill.com,cnn.com,foxnews.com,nytimes.com,washingtonpost.com,wsj.com

# ---- Free sources (optional keys; each one is skipped when empty) ----
# Ravelry read-only basic-auth key (knitting/crochet patterns); the username starts with read-
RAVELRY_USER=
RAVELRY_KEY=
# YouTube Data API v3 key (tutorial videos; about 100 searches a day free)
YOUTUBE_API_KEY=
# Twitch developer app, client credentials (live category numbers)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The Guardian Open Platform and New York Times (Top Stories, Most Popular, Books)
GUARDIAN_API_KEY=
NYT_API_KEY=

# ---- Older place settings (personal.json is used first; these are fallbacks) ----
OTHOS_WEATHER_LOCATION=
OTHOS_WEATHER_LATLON=
OTHOS_HOME_LOCATION=
OTHOS_CONTACT_URL=

# Optional: copy PDFs from your own S3 bucket into the library (Add documents window, "From AWS").
# Use a key that can only READ that bucket: the window's "How to set up a key" button shows how.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
OTHOS_S3_BUCKET=
# OTHOS_S3_PREFIX=manuals/
